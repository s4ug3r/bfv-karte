# ─── Google Maps ────────────────────────────────────────────────────────────
# API-Key mit aktivierter "Maps JavaScript API", "Places API (New)" und "Geocoding API".
# Unbedingt per HTTP-Referrer auf deine Domain(s) beschränken (siehe README).
VITE_GOOGLE_MAPS_API_KEY=

# Map-ID für Advanced Markers (Google Cloud Console → Maps Management).
# Ohne Angabe wird "DEMO_MAP_ID" verwendet (nur für Entwicklung gedacht).
VITE_GOOGLE_MAPS_MAP_ID=

# ─── BFV-Datenquelle ────────────────────────────────────────────────────────
# Welcher Data-Provider genutzt wird: "bfv" | "rest" | "static"
# Ohne Angabe: "rest", wenn VITE_BFV_API_BASE_URL gesetzt ist, sonst "bfv"
# (BFV-Widget-Schnittstelle über die Bibliothek bfv-api).
VITE_BFV_DATA_PROVIDER=

# ── Provider "bfv" ──
# Proxy-Pfad zur BFV-Schnittstelle (Dev-Server: vite.config.ts, Hosting: public/_redirects bzw. vercel.json).
VITE_BFV_PROXY_URL=/bfv-api
# Proxy-Pfad zu www.bfv.de (Vereinsseiten mit allen Mannschaften – für die Umgebungserkundung).
VITE_BFV_WEB_PROXY_URL=/bfv-web
# Optionaler vorausgefüllter Startpunkt für die erste Erkundung (bfv.de-Link eines Vereins/einer Mannschaft).
VITE_BFV_SEED=
# Link zur Spieldetailseite ({matchId} wird ersetzt). Leer lassen = kein Link.
VITE_BFV_MATCH_URL_TEMPLATE=https://www.bfv.de/ergebnisse/spiel/-/{matchId}

# ── Provider "rest" ──
# Basis-URL eines eigenen Backends mit dem Endpunkt GET /matches (Vertrag siehe README).
VITE_BFV_API_BASE_URL=
# "true", wenn das Backend lat/lng/radiusKm auswertet (Flächenabfrage).
VITE_BFV_API_AREA_QUERY=true

# ── Provider "static" ──
# URL einer vorab exportierten JSON-Datei.
VITE_BFV_STATIC_URL=/data/matches.json
